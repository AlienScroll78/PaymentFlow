{
  "title": "PaymentFlow - SLOs and Error Budgets",
  "uid": "paymentflow-slos",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-30d", "to": "now" },
  "tags": ["slo", "error-budget", "payments"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API Availability",
      "description": "30-day availability target: 99.9%",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 6 },
      "targets": [{ "expr": "1 - sum(increase(http_request_duration_seconds_count{status=~\"5..\"}[30d])) / clamp_min(sum(increase(http_request_duration_seconds_count[30d])), 1)", "legendFormat": "availability" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 0.999 }, { "color": "green", "value": 0.9995 }] } } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API Latency p95",
      "description": "30-day target: below 1 second",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 6 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[10m])) by (le))", "legendFormat": "p95" }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] } } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Transaction Queue Age",
      "description": "30-day target: oldest transaction below 60 seconds",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 6 },
      "targets": [{ "expr": "transaction_queue_oldest_age_seconds", "legendFormat": "oldest age" }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 60 }] } } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Webhook Success",
      "description": "30-day target: 99.5% delivered",
      "gridPos": { "x": 0, "y": 6, "w": 8, "h": 6 },
      "targets": [{ "expr": "sum(increase(webhook_delivery_total{status=~\"success|delivered\"}[30d])) / clamp_min(sum(increase(webhook_delivery_total[30d])), 1)", "legendFormat": "success" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 0.995 }, { "color": "green", "value": 0.999 }] } } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Reconciliation Lag",
      "description": "30-day target: below 15 minutes. Requires reconciliation_lag_seconds instrumentation.",
      "gridPos": { "x": 8, "y": 6, "w": 8, "h": 6 },
      "targets": [{ "expr": "reconciliation_lag_seconds", "legendFormat": "lag" }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 900 }] } } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Payment Error Budget Burn",
      "description": "Short-window 5xx ratio for payment routes; target is 99.9% availability.",
      "gridPos": { "x": 16, "y": 6, "w": 8, "h": 6 },
      "targets": [{ "expr": "sum(rate(http_request_duration_seconds_count{status=~\"5..\",route=~\".*/payments.*\"}[5m])) / clamp_min(sum(rate(http_request_duration_seconds_count{route=~\".*/payments.*\"}[5m])), 0.001)", "legendFormat": "5xx burn" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 0.05 }] } } }
    }
  ]
}
